# Backend Web Service environment on Render.
# Replace every placeholder. Never commit the completed file or put these values in the frontend.
DATABASE_URI=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_ORIGINS=["https://YOUR-STATIC-SITE.onrender.com"]
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST:6379
SPAM_THRESHOLD=0.5
SQL_ECHO=false

# The API's Docker command listens on 8000. Set this only if configuring Render's port explicitly.
PORT=8000

# Static Site: no environment variables are needed. frontend/app.js selects the deployed API URL.
# Grafana Cloud scrapes the API's public https://YOUR-API.onrender.com/metrics endpoint.
# No Grafana Cloud credential belongs in this backend env file for Metrics Endpoint integration.
