DATABASE_URI=sqlite+aiosqlite:///./app/database.db
JWT_SECRET=                            # Required, at least 32 characters. Generate: openssl rand -hex 32
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
SQL_ECHO=false                         # true logs every SQL statement with its parameters. Local debugging only.
SPAM_THRESHOLD=0.5                     # Spam probability (0 to 1) at or above which a message is labelled spam
REDIS_URL=redis://localhost:6379/0     # In Docker Compose this is set to redis://redis:6379/0
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500"]   # JSON list of browser origins allowed by CORS
GRAFANA_ADMIN_PASSWORD=                # Only used by docker compose. Required there, pick a strong one.
