# Copy to .env for Docker Compose: cp .env.example .env
# Use a development database reachable from the Docker containers. Do not put production secrets here.
DATABASE_URI=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
SQL_ECHO=false
SPAM_THRESHOLD=0.5

# Compose overrides this with redis://redis:6379/0 for the Redis container.
REDIS_URL=redis://localhost:6379/0

# Compose overrides this with the local frontend origins.
ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# Required by the local Grafana container.
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-local-password
